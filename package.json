{
  "name": "mobility-transactions-domain",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm run \"/dev:/\"",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --enable-source-maps --watch dist/main.js",
    "auth:generate": "pnpm with-env pnpm exec better-auth generate --config ./src/shared/infrastructure/auth/better-auth.ts --output ./migrations/better-auth.schema.sql",
    "auth:migrate": "pnpm with-env pnpm exec better-auth migrate --config ./src/shared/infrastructure/auth/better-auth.ts",
    "auth:migrate:dry-run": "pnpm with-env pnpm exec better-auth generate --config ./src/shared/infrastructure/auth/better-auth.ts",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "deps": "pnpm dlx taze@latest -Ilw",
    "deps:major": "pnpm dlx taze@latest major -Ilw",
    "prepare": "lefthook install",
    "with-env": "dotenv -e .env --",
    "seed": "pnpm with-env node --enable-source-maps dist/shared/infrastructure/database/seeds/run-seeds.js",
    "dbctl": "pnpm with-env node --enable-source-maps dist/shared/infrastructure/database/cli/dbctl.js",
    "start": "node dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanurb/typescript-node-esm-skeleton.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sanurb/typescript-node-esm-skeleton/issues"
  },
  "homepage": "https://github.com/sanurb/typescript-node-esm-skeleton#readme",
  "devDependencies": {
    "@better-auth/cli": "latest",
    "@biomejs/biome": "2.3.15",
    "@faker-js/faker": "^10.3.0",
    "@testcontainers/postgresql": "^11.11.0",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^4.0.18",
    "archunit": "^2.1.63",
    "dotenv-cli": "^10.0.0",
    "lefthook": "^2.1.0",
    "sequelize-cli": "^6.6.5",
    "testcontainers": "^11.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ultracite": "7.2.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/otel": "^0.16.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/instrumentation-http": "^0.212.0",
    "@opentelemetry/instrumentation-pg": "^0.63.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "latest",
    "better-result": "^2.7.0",
    "consola": "^3.4.2",
    "dotenv": "^17.2.4",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "gunshi": "^0.28.2",
    "jose": "^6.1.3",
    "kysely": "^0.28.11",
    "kysely-sequelize": "^0.2.0",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "std-env": "^3.10.0",
    "umzug": "^3.8.2",
    "zod": "^4.3.6"
  }
}
