# Server Configuration
PORT=3000
APP_NAME=Mobility Transactions API

# Database Configuration
DATABASE_URL=postgresql://mobility:mobility_dev_password@localhost:5432/mobility_transactions
# Optional for containerized runtime (compose): defaults to postgres service DNS.
DOCKER_DATABASE_URL=postgresql://mobility:mobility_dev_password@postgres:5432/mobility_transactions
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_ACQUIRE=30000
DATABASE_POOL_IDLE=10000

# JWT Configuration
JWT_ISSUER=mobility-transactions
JWT_AUDIENCE=mobility-api

# Better Auth Configuration
BETTER_AUTH_SECRET=your-better-auth-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Observability Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
