# AI Provider (required). Override with GGA_PROVIDER if needed.
# Options: claude, gemini, codex, opencode, ollama:<model>
PROVIDER="claude"

# File patterns to include in review (comma-separated)
FILE_PATTERNS="*.ts,*.tsx,*.js,*.jsx"

# File patterns to exclude from review (comma-separated)
EXCLUDE_PATTERNS="*.test.ts,*.test.tsx,*.spec.ts,*.spec.tsx,*.d.ts"

# File containing code review rules
RULES_FILE="AGENTS.md"

# Fail if AI response is ambiguous (recommended for CI)
STRICT_MODE="true"
